# === BUAA SSO 登录凭据 ===
BUAA_USERNAME=your_student_id
BUAA_PASSWORD=your_password

# === Telegram Bot ===
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# === Email SMTP (Gmail) ===
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your_gmail@gmail.com
SMTP_PASSWORD=your_app_password
# 可选：覆盖不同类型邮件的发件人地址（用于 Brevo 多 Sender）
SMTP_FROM=notify@example.com
SMTP_FROM_VERIFY=verify@example.com
SMTP_FROM_LOGIN=verify@example.com
SMTP_FROM_NOTIFY=notify@example.com
SMTP_FROM_REMINDER=notify@example.com
# 可选：按邮件类型拆分 SMTP 通道（不使用 Brevo 时可用）
# 验证/登录邮件通道（例如 QQ SMTP）
SMTP_VERIFY_SERVER=smtp.qq.com
SMTP_VERIFY_PORT=465
SMTP_VERIFY_USE_TLS=false
SMTP_VERIFY_USERNAME=verify@qq.com
SMTP_VERIFY_PASSWORD=qq_smtp_auth_code
# 通知/提醒邮件通道（例如 Gmail SMTP）
SMTP_NOTIFY_SERVER=smtp.gmail.com
SMTP_NOTIFY_PORT=587
SMTP_NOTIFY_USE_TLS=true
SMTP_NOTIFY_USERNAME=notify@gmail.com
SMTP_NOTIFY_PASSWORD=gmail_app_password
# notify/reminder 默认优先走 SMTP_NOTIFY_*；若失败，会自动回退到 SMTP_VERIFY_*（常用于 QQ 兜底）
# 可选：仅当 SMTP 需要单独走代理时设置；邮件模块不会再读取 HTTP_PROXY / HTTPS_PROXY
SMTP_PROXY=http://127.0.0.1:7890

# === Web Console ===
WEB_HOST=127.0.0.1
WEB_PORT=5000
# 单进程 WSGI 并发线程数；不要改为多 worker，以免重复启动调度器和浏览器。
# WEB_THREADS=8
# 必须替换为随机值（至少 32 个字符），不要提交真实密钥。
WEB_SECRET_KEY=replace-with-a-random-secret-at-least-32-chars
# 应用层管理认证：生产反代仍需配置 Nginx .htpasswd；Bearer token 可供受控自动化直连使用。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
# ADMIN_API_TOKEN=replace-with-a-random-token
# 对外访问基址（用于验证/登录邮件链接生成，务必填公网域名）
APP_PUBLIC_BASE_URL=https://buaaboya.top
APP_ALLOWED_ORIGINS=https://buaaboya.top,https://www.buaaboya.top
APP_TIMEZONE=Asia/Shanghai
DATABASE_PATH=boya_agent.db

# === Authentication / upload limits ===
AUTH_CHALLENGE_TTL_SECONDS=900
LOGIN_BRIDGE_TTL_SECONDS=900
VERIFICATION_CODE_TTL_MINUTES=20
AUTH_CODE_MAX_ATTEMPTS=5
LOGIN_IP_COOLDOWN_SECONDS=5
QRCODE_MAX_FILE_SIZE=5242880

# === Scheduler ===
SCRAPE_INTERVAL_MINUTES=10
# 新课摘要窗口（分钟）
PUSH_URGENT_DIGEST_MINUTES=5
PUSH_SOON_DIGEST_MINUTES=30
# 可选：高级巡检和浏览器回收参数，未设置时使用代码默认值
# ACTIVE_ENROLL_SCRAPE_SECONDS=30
# ACTIVE_ENROLL_JUST_STARTED_MINUTES=15
# ACTIVE_ENROLL_NOTIFY_MIN_REMAINING=8
# HOT_COURSE_REMAINING_THRESHOLD=3
# HOT_COURSE_FILL_RATIO=0.82
# HOT_COURSE_WATCH_SECONDS=15
# HOT_COURSE_STALE_SECONDS=25
# BROWSER_MAX_SCRAPE_RUNS=80
# BROWSER_HARD_MAX_SCRAPE_RUNS=140
# BROWSER_DEFER_RECYCLE_WHEN_HOT=true
# SCRAPE_TASK_TIMEOUT_SECONDS=900
# COURSE_PAGE_NETWORK_IDLE_TIMEOUT_MS=5000
# SCRAPE_CAPTURE_DIAGNOSTICS=false
# 自动选课当天累计失败达到该次数后暂停后续尝试
# AUTO_ENROLL_FAILURE_LIMIT=3
